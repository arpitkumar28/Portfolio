# Upstash Redis REST credentials used by the visitor counter API.
UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<replace-with-a-rotated-token>

# Alternatively, use the Upstash TCP connection string instead of the REST values.
# REDIS_URL=rediss://default:<rotated-token>@<host>:<port>
